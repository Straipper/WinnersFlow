# ===== Deployment =====
NODE_ENV=production
PORT=3000
DT_FLOW_DOMAIN=app.example.com
APP_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com

# ===== PostgreSQL =====
POSTGRES_DB=dt_flow
POSTGRES_USER=dtflow
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://dtflow:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@db:5432/dt_flow
# The bundled Docker PostgreSQL runs on the private Docker network.
DATABASE_SSL=false

# ===== Market data =====
MARKET_DATA_PROVIDER=twelve_data
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.twelvedata.com
MARKET_DATA_PREPOST=false

# ===== Stripe LIVE =====
STRIPE_SECRET_KEY=sk_live_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_PRICE_ID=price_REPLACE

# ===== DT FLOW signing =====
# Generate with: openssl rand -base64 48
APP_SIGNING_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS

# ===== Email (configure at the very end) =====
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# OptionWhales Pro API (server-side only; never expose in frontend)
OPTIONWHALES_API_KEY=
