PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5500
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dt_flow

# Step 5 — real market data
# Set to twelve_data to use Twelve Data instead of mock data.
MARKET_DATA_PROVIDER=twelve_data
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.twelvedata.com
MARKET_DATA_PREPOST=false

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
APP_URL=http://localhost:5500
# Step 29 — cryptographic signing secret (use a random 32+ byte value in production)
APP_SIGNING_SECRET=

# Step 28 — owner/admin notifications (leave blank until final configuration)
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# OptionWhales Pro API (server-side only; never expose in frontend)
OPTIONWHALES_API_KEY=

# Bootstrap admin (run once, then remove these values from the environment)
ADMIN_BOOTSTRAP_EMAIL=admin@dtflow.local
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=
